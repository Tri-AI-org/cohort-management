---
/**
 * Portal header — deliberately minimal.
 *
 * The marketing site (tri-ai.org) has a primary nav (About, Programmes,
 * Research, Get Involved). The portal doesn't, because:
 *
 *   - A student in the middle of marking attendance shouldn't see a
 *     menu of distractions inviting them to navigate away.
 *   - There's no "browse" surface on the portal — you arrive at a
 *     specific cohort URL and you stay on that cohort's pages.
 *
 * So the header has: a wordmark that says where you are (cohort
 * portal of tri-ai.org), a theme toggle, and a back-to-main-site
 * link. Nothing else.
 */
---

<header class="hdr">
  <div class="container hdr-inner">
    <a href="/" class="hdr-brand" aria-label="Cohort portal home">
      <span class="wm-tri">tri</span><span class="wm-ai">AI</span>
      <span class="wm-sep" aria-hidden="true">/</span>
      <span class="wm-portal">cohort portal</span>
    </a>

    <div class="hdr-meta">
      <a href="https://tri-ai.org" class="mono" rel="noopener">tri-ai.org →</a>
      <button
        type="button"
        class="theme-toggle"
        aria-label="Toggle theme"
        data-theme-toggle
      >
        <svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
        <svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  // Theme toggle — same behaviour as the main site, separate storage
  // key so the two sites can theme independently if a user prefers.
  // (In practice almost everyone will toggle once on whichever site
  // they hit first and not think about it again.)
  (function () {
    const btn = document.querySelector('[data-theme-toggle]');
    if (!btn) return;
    btn.addEventListener('click', function () {
      const root = document.documentElement;
      const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('triai-portal-theme', next); } catch (e) {}
    });
  })();
</script>
