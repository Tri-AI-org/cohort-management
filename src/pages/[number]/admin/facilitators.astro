---
/**
 * /[number]/admin/facilitators
 *
 * Facilitator roster management. Reachable by:
 *   - Organisers (full powers)
 *   - Lead facilitators of this cohort (subset: add/remove peers,
 *     resend invites; CANNOT promote/demote leads)
 *
 * Backend permission enforcement is in facilitators-admin.mjs.
 * This page just calls the API and shows what comes back.
 */
import AppShell from '../../../layouts/AppShell.astro';
import AdminNav from '../../../components/AdminNav.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const cohorts = await getCollection('cohorts');
  return cohorts
    .filter(c => c.data.portal?.enabled)
    .map(c => ({
      params: { number: String(c.data.number) },
      props:  { cohort: c },
    }));
}

const { cohort } = Astro.props;
const cohortNumber = cohort.data.number;
---
<AppShell
  title={`Facilitators · Cohort ${cohortNumber}`}
  requiredKind="facilitator-or-organiser"
  cohortNumber={cohortNumber}
>
  <div class="container app-page">
    <!-- Show AdminNav only to organisers — lead facilitators don't get
         to see the rest of the admin surfaces. Decided client-side
         based on session.kind below. -->
    <div id="organiser-nav-wrap" hidden>
      <AdminNav cohortNumber={cohortNumber} active="facilitators" />
    </div>

    <!-- Compact back-link for lead facilitators -->
    <div id="lead-nav-wrap" hidden style="margin-bottom: var(--space-3);">
      <a href={`/${cohortNumber}/facilitator`} class="btn btn-link">← Back to my dashboard</a>
    </div>

    <div style="display:flex; align-items:baseline; justify-content:space-between; gap:var(--space-3); margin-bottom:var(--space-3); flex-wrap:wrap;">
      <div>
        <h1>Facilitators</h1>
        <p class="lede" id="lede">Loading…</p>
      </div>
      <button class="btn primary" id="add-btn">+ Add facilitator</button>
    </div>

    <div id="error" class="auth-msg err" hidden></div>
    <div id="success" class="auth-msg ok" hidden></div>

    <table class="data-table" id="fac-table" hidden>
      <thead>
        <tr>
          <th>Facilitator</th>
          <th>Country</th>
          <th class="right">Sessions</th>
          <th>Role</th>
          <th class="right">Actions</th>
        </tr>
      </thead>
      <tbody id="fac-tbody"></tbody>
    </table>

    <div id="empty" class="empty-state" hidden>
      <p>No facilitators on this cohort yet. Click "+ Add facilitator" to send an onboarding invite.</p>
    </div>
  </div>

  <!-- Add-facilitator drawer -->
  <div class="drawer" id="add-drawer" hidden>
    <div class="drawer-backdrop" data-drawer-close></div>
    <div class="drawer-panel">
      <header class="drawer-head">
        <h2>Add a facilitator</h2>
        <button class="btn-link" data-drawer-close>Close</button>
      </header>
      <div class="drawer-body">
        <p class="card-sub">
          Adding a facilitator creates their account if it doesn't exist
          and sends them a sign-in email with a 7-day link. They'll
          finish setting up their profile after they click in.
        </p>
        <form id="add-form">
          <label>Email <span class="required">*</span>
            <input name="email" type="email" required placeholder="facilitator@example.com" />
          </label>
          <div class="row">
            <label>First name<input name="first_name" placeholder="optional" /></label>
            <label>Last name <input name="last_name"  placeholder="optional" /></label>
          </div>
          <label class="checkbox-label" id="lead-toggle-wrap">
            <input type="checkbox" name="as_lead" />
            <span>Make them a lead facilitator</span>
            <span class="hint">Lead facilitators can manage the facilitator roster on this cohort (add, remove, resend invites).</span>
          </label>
        </form>
      </div>
      <footer class="drawer-foot">
        <button class="btn primary" id="add-submit">Send invite →</button>
        <span id="add-status" class="form-status"></span>
      </footer>
    </div>
  </div>

  <style>
    .data-table th.right, .data-table td.right { text-align: right; }
    .role-pill {
      display: inline-block; padding: 2px 8px; border-radius: 4px;
      font-size: 11px; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.04em;
    }
    .role-pill.lead { background: var(--alert); color: #fff; }
    .role-pill.regular { background: var(--gold-light); color: var(--gold-deep); }

    .row-actions {
      display: flex; gap: 8px; justify-content: flex-end;
    }
    .row-actions button {
      padding: 4px 9px;
      background: #fff;
      border: 1px solid var(--border, #d4d4d4);
      border-radius: 5px;
      font: inherit; font-size: 12px;
      color: var(--text-dim, #555);
      cursor: pointer;
    }
    .row-actions button:hover { color: var(--text, #141414); border-color: var(--text-dim, #888); }
    .row-actions button.danger { color: var(--alert); }
    .row-actions button.danger:hover { background: #FBE9E9; border-color: var(--alert); }

    .empty-state {
      background: #fff;
      border: 1px dashed var(--border, rgba(0,0,0,0.12));
      border-radius: 10px;
      padding: 32px;
      text-align: center;
      color: var(--text-dim, #888);
    }

    .drawer { position: fixed; inset: 0; z-index: 100; }
    .drawer-backdrop {
      position: absolute; inset: 0; background: rgba(0,0,0,0.4);
    }
    .drawer-panel {
      position: absolute; top: 0; right: 0; bottom: 0;
      width: min(560px, 100vw); background: #fff;
      box-shadow: -4px 0 24px rgba(0,0,0,0.15);
      display: flex; flex-direction: column;
    }
    .drawer-head, .drawer-foot {
      padding: 16px 24px;
      display: flex; align-items: center; justify-content: space-between;
      gap: 12px;
    }
    .drawer-head { border-bottom: 1px solid var(--border, rgba(0,0,0,0.08)); }
    .drawer-foot { border-top: 1px solid var(--border, rgba(0,0,0,0.08)); }
    .drawer-head h2 { margin: 0; font-size: 18px; }
    .drawer-body { flex: 1; overflow-y: auto; padding: 20px 24px; }
    .card-sub {
      color: var(--text-dim, #666); font-size: 13px; line-height: 1.55;
      margin: 0 0 18px;
    }

    #add-form label {
      display: block; margin-bottom: 14px;
      font-size: 13px; font-weight: 600;
    }
    #add-form .row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    #add-form input {
      display: block; width: 100%; box-sizing: border-box;
      margin-top: 5px;
      padding: 9px 12px;
      border: 1px solid var(--border, #d4d4d4);
      border-radius: 7px;
      font: inherit; font-size: 14px;
      font-weight: 400;
    }
    .required { color: var(--alert); }
    .checkbox-label {
      display: grid !important;
      grid-template-columns: 18px 1fr;
      gap: 8px 10px;
      padding: 8px 0;
    }
    .checkbox-label input { width: 18px; height: 18px; margin: 0; }
    .checkbox-label > span { font-weight: 600; }
    .checkbox-label .hint { grid-column: 2; font-weight: 400; font-size: 12px; color: var(--text-dim, #888); margin-top: 4px; }
    .form-status { font-size: 12px; color: var(--text-dim, #888); }
    .form-status.err { color: var(--alert); }
    .form-status.ok  { color: var(--success); }
  </style>

  <script is:inline define:vars={{ cohortNumber }}>
    (function () {
      const $ = (id) => document.getElementById(id);
      const state = { facilitators: [], canPromote: false };

      load();

      async function load() {
        // First determine who we are
        try {
          const sr = await fetch('/api/session', { credentials: 'same-origin' });
          if (!sr.ok) { location.replace('/signin?cohort=' + cohortNumber); return; }
          const session = await sr.json();
          state.canPromote = session.kind === 'organiser';

          if (session.kind === 'organiser') {
            $('organiser-nav-wrap').hidden = false;
          } else {
            $('lead-nav-wrap').hidden = false;
          }
          // Lead facilitators don't see the "make them a lead" checkbox
          $('lead-toggle-wrap').hidden = !state.canPromote;
        } catch {}

        // Now fetch the roster
        try {
          const res = await fetch('/api/facilitators-admin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ action: 'list', cohort: cohortNumber }),
          });
          if (res.status === 403) {
            const data = await res.json();
            showError(data.error || 'You do not have permission.');
            return;
          }
          if (!res.ok) {
            const data = await res.json();
            showError(data.error || 'Failed to load.');
            return;
          }
          const data = await res.json();
          state.facilitators = data.facilitators || [];
          render();
        } catch {
          showError('Network error.');
        }
      }

      function render() {
        const fs = state.facilitators;
        $('lede').textContent = fs.length === 0
          ? 'No facilitators on this cohort yet.'
          : `${fs.length} facilitator${fs.length === 1 ? '' : 's'} on this cohort.`;

        if (fs.length === 0) {
          $('empty').hidden = false;
          $('fac-table').hidden = true;
          return;
        }
        $('empty').hidden = true;
        $('fac-table').hidden = false;

        const tbody = $('fac-tbody');
        tbody.innerHTML = '';
        for (const f of fs) {
          const tr = document.createElement('tr');
          const name = [f.first_name, f.last_name].filter(Boolean).join(' ').trim()
            || (f.email && !f.first_name ? '(name pending)' : f.email);

          const roleHtml = f.is_lead
            ? '<span class="role-pill lead">Lead</span>'
            : '<span class="role-pill regular">Facilitator</span>';

          let actionsHtml = '<div class="row-actions">';
          actionsHtml += '<button data-action="resend" data-id="' + f.enrolment_id + '">Resend invite</button>';
          if (state.canPromote) {
            if (f.is_lead) {
              actionsHtml += '<button data-action="demote" data-id="' + f.enrolment_id + '">Demote</button>';
            } else {
              actionsHtml += '<button data-action="promote" data-id="' + f.enrolment_id + '">Make lead</button>';
            }
          }
          actionsHtml += '<button data-action="remove" data-id="' + f.enrolment_id + '" class="danger">Remove</button>';
          actionsHtml += '</div>';

          tr.innerHTML =
            '<td>' +
              '<div style="font-weight:600">' + escapeHtml(name) + '</div>' +
              '<div class="mono" style="font-size:12px;color:#888">' + escapeHtml(f.email || '') + '</div>' +
            '</td>' +
            '<td>' + escapeHtml(f.country || '—') + '</td>' +
            '<td class="right mono">' + (f.sessions_assigned || 0) + '</td>' +
            '<td>' + roleHtml + '</td>' +
            '<td class="right">' + actionsHtml + '</td>';
          tbody.appendChild(tr);
        }

        tbody.querySelectorAll('[data-action]').forEach(b => {
          b.addEventListener('click', () => doAction(b.dataset.action, b.dataset.id, b));
        });
      }

      async function doAction(action, enrolmentId, btn) {
        let actionName;
        switch (action) {
          case 'resend':  actionName = 'resend_invite'; break;
          case 'remove':
            if (!confirm('Remove this facilitator from the cohort? They will be unassigned from any sessions they were teaching.')) return;
            actionName = 'remove'; break;
          case 'promote': actionName = 'promote_lead'; break;
          case 'demote':
            if (!confirm('Demote this lead facilitator? They will lose access to roster management.')) return;
            actionName = 'demote_lead'; break;
          default: return;
        }
        btn.disabled = true;
        try {
          const res = await fetch('/api/facilitators-admin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ action: actionName, cohort: cohortNumber, enrolmentId }),
          });
          const data = await res.json();
          if (!res.ok) { showError(data.error || 'Action failed.'); return; }
          showSuccess(
            action === 'resend'  ? 'Invite resent.' :
            action === 'remove'  ? 'Facilitator removed.' :
            action === 'promote' ? 'Promoted to lead.' :
            action === 'demote'  ? 'Demoted to regular facilitator.' :
            'Done.'
          );
          await load();
        } catch {
          showError('Network error.');
        } finally {
          btn.disabled = false;
        }
      }

      // Add drawer
      $('add-btn').addEventListener('click', () => {
        $('add-drawer').hidden = false;
        $('add-form').reset();
        $('add-status').textContent = '';
      });
      document.querySelectorAll('[data-drawer-close]').forEach(el => {
        el.addEventListener('click', () => { $('add-drawer').hidden = true; });
      });
      $('add-submit').addEventListener('click', async () => {
        const form = $('add-form');
        const email      = form.elements['email'].value.trim();
        const firstName  = form.elements['first_name'].value.trim();
        const lastName   = form.elements['last_name'].value.trim();
        const asLead     = form.elements['as_lead'] && form.elements['as_lead'].checked;
        if (!email) {
          $('add-status').className = 'form-status err';
          $('add-status').textContent = 'Email is required.'; return;
        }
        $('add-submit').disabled = true;
        $('add-status').className = 'form-status';
        $('add-status').textContent = 'Inviting…';
        try {
          const res = await fetch('/api/facilitators-admin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({
              action: 'add', cohort: cohortNumber,
              email, first_name: firstName, last_name: lastName, as_lead: asLead,
            }),
          });
          const data = await res.json();
          if (!res.ok) {
            $('add-status').className = 'form-status err';
            $('add-status').textContent = data.error || 'Could not add.';
            return;
          }
          $('add-status').className = 'form-status ok';
          $('add-status').textContent = data.emailSent
            ? 'Added and invite sent.'
            : 'Added (invite email failed — try Resend invite).';
          setTimeout(() => { $('add-drawer').hidden = true; load(); }, 800);
        } catch {
          $('add-status').className = 'form-status err';
          $('add-status').textContent = 'Network error.';
        } finally {
          $('add-submit').disabled = false;
        }
      });

      function showError(t)   { $('error').textContent = t; $('error').hidden = false; window.scrollTo(0,0); }
      function showSuccess(t) { $('success').textContent = t; $('success').hidden = false; setTimeout(() => $('success').hidden = true, 3000); }
      function escapeHtml(s)  { return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
    })();
  </script>
</AppShell>
