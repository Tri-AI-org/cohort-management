---
/**
 * /[number]/admin/students
 *
 * Standalone students list with filter, search, and pagination.
 *
 * Hits /api/dashboard with action=students. Filter buttons map to
 * the risk_status filter (ok/warning/critical). Click a row to open
 * that student's profile drawer (in this MVP: shows the same data
 * the /me page would, plus organiser-only notes).
 */
import AppShell from '../../../layouts/AppShell.astro';
import AdminNav from '../../../components/AdminNav.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const cohorts = await getCollection('cohorts');
  return cohorts
    .filter(c => c.data.portal?.enabled)
    .map(c => ({
      params: { number: String(c.data.number) },
      props:  { cohort: c },
    }));
}

const { cohort } = Astro.props;
const cohortNumber = cohort.data.number;
---
<AppShell
  title={`Students · Cohort ${cohortNumber}`}
  requiredKind="organiser"
  cohortNumber={cohortNumber}
>
  <div class="container app-page">
    <AdminNav cohortNumber={cohortNumber} active="students" />

    <div style="margin-bottom: var(--space-3);">
      <h1>Students</h1>
      <p class="lede" id="lede">Loading…</p>
    </div>

    <div id="error" class="auth-msg err" hidden></div>

    <div class="toolbar">
      <input type="search" id="search" placeholder="Search name or email…" />
      <div class="filter-pills">
        <button class="pill active" data-filter="">All</button>
        <button class="pill" data-filter="ok">On track</button>
        <button class="pill" data-filter="warning">Warning</button>
        <button class="pill" data-filter="critical">Critical</button>
      </div>
      <span style="flex:1"></span>
      <span class="toolbar-count" id="count">—</span>
    </div>

    <table class="data-table" id="students-table">
      <thead>
        <tr>
          <th>Student</th>
          <th>Country</th>
          <th class="right">Attended</th>
          <th class="right">Missed</th>
          <th class="right">Attendance</th>
          <th>Risk</th>
        </tr>
      </thead>
      <tbody id="students-tbody">
        <tr><td colspan="6" class="empty">Loading…</td></tr>
      </tbody>
    </table>

    <div class="pagination">
      <span id="page-info">—</span>
      <div>
        <button id="prev-btn" disabled>← Prev</button>
        <button id="next-btn" disabled>Next →</button>
      </div>
    </div>
  </div>

  <!-- Student detail drawer -->
  <div class="drawer" id="drawer" hidden>
    <div class="drawer-backdrop" data-drawer-close></div>
    <div class="drawer-panel">
      <header class="drawer-head">
        <h2 id="drawer-title">Student</h2>
        <button class="btn-link" data-drawer-close>Close</button>
      </header>
      <div class="drawer-body" id="drawer-body">Loading…</div>
    </div>
  </div>

  <style>
    /* admin-nav styles moved to AdminNav.astro component */

    .drawer { position: fixed; inset: 0; z-index: 100; }
    .drawer-backdrop {
      position: absolute; inset: 0; background: rgba(0,0,0,0.4);
      animation: fade-in 0.15s;
    }
    .drawer-panel {
      position: absolute; top: 0; right: 0; bottom: 0;
      width: min(560px, 100vw); background: #fff;
      box-shadow: -4px 0 24px rgba(0,0,0,0.15);
      display: flex; flex-direction: column;
      animation: slide-in 0.2s;
    }
    .drawer-head {
      padding: 16px 24px;
      border-bottom: 1px solid var(--border, rgba(0,0,0,0.08));
      display: flex; align-items: center; justify-content: space-between;
    }
    .drawer-head h2 { margin: 0; font-size: 18px; }
    .drawer-body {
      flex: 1; overflow-y: auto; padding: 20px 24px;
      font-size: 14px; line-height: 1.55;
    }
    .drawer-body dt {
      font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em;
      color: var(--text-dim, #888); font-weight: 600; margin-top: 12px;
    }
    .drawer-body dd { margin: 4px 0 0; }
    @keyframes slide-in { from { transform: translateX(100%); } to { transform: none; } }
    @keyframes fade-in  { from { opacity: 0; } to { opacity: 1; } }

    .filter-pills { display: flex; gap: 4px; }
    .pill {
      padding: 6px 12px;
      background: #fff; border: 1px solid var(--border, #d4d4d4);
      border-radius: 999px;
      font: inherit; font-size: var(--t-small);
      cursor: pointer; transition: all 0.15s;
    }
    .pill:hover { background: var(--bg-soft, #fafafa); }
    .pill.active {
      background: var(--teaching); color: #fff; border-color: var(--teaching);
    }
  </style>

  <script is:inline define:vars={{ cohortNumber }}>
    (function () {
      const $ = (id) => document.getElementById(id);
      const state = {
        page: 1, pageSize: 50,
        filter: '', search: '',
        total: 0,
      };

      $('search').addEventListener('input', debounce(() => {
        state.search = $('search').value.trim();
        state.page = 1; load();
      }, 250));
      document.querySelectorAll('.pill').forEach(p => {
        p.addEventListener('click', () => {
          document.querySelectorAll('.pill').forEach(x => x.classList.remove('active'));
          p.classList.add('active');
          state.filter = p.dataset.filter;
          state.page = 1;
          load();
        });
      });
      $('prev-btn').addEventListener('click', () => { if (state.page > 1) { state.page--; load(); } });
      $('next-btn').addEventListener('click', () => { state.page++; load(); });

      document.querySelectorAll('[data-drawer-close]').forEach(el => {
        el.addEventListener('click', () => { $('drawer').hidden = true; });
      });

      load();

      async function load() {
        $('students-tbody').innerHTML = '<tr><td colspan="6" class="empty">Loading…</td></tr>';
        try {
          const res = await fetch('/api/dashboard', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({
              action: 'students',
              cohort: cohortNumber,
              search: state.search || undefined,
              filter: state.filter || undefined,
              page: state.page,
              pageSize: state.pageSize,
            }),
          });
          if (res.status === 401) { location.replace('/admin/login'); return; }
          const data = await res.json();
          if (!res.ok) {
            $('students-tbody').innerHTML = '<tr><td colspan="6" class="empty">' + escapeHtml(data.error || 'Failed.') + '</td></tr>';
            return;
          }
          state.total = data.total || 0;
          render(data.rows || []);
        } catch (err) {
          $('students-tbody').innerHTML = '<tr><td colspan="6" class="empty">Network error.</td></tr>';
        }
      }

      function render(rows) {
        $('count').textContent = state.total + ' student' + (state.total === 1 ? '' : 's');
        $('lede').textContent = state.total + ' active student' + (state.total === 1 ? '' : 's') + ' in this cohort';
        if (rows.length === 0) {
          $('students-tbody').innerHTML = '<tr><td colspan="6" class="empty">No students match.</td></tr>';
          renderPagination();
          return;
        }
        const tbody = $('students-tbody');
        tbody.innerHTML = '';
        for (const r of rows) {
          const tr = document.createElement('tr');
          tr.style.cursor = 'pointer';
          tr.dataset.id = r.enrolment_id;
          tr.innerHTML =
            '<td>' +
              '<div style="font-weight:600">' + escapeHtml(r.first_name + ' ' + r.last_name) + '</div>' +
              '<div class="mono" style="font-size:12px;color:#888">' + escapeHtml(r.email) + '</div>' +
            '</td>' +
            '<td>' + escapeHtml(r.country || '—') + '</td>' +
            '<td class="right mono">' + (r.attended_count ?? 0) + '</td>' +
            '<td class="right mono">' + (r.missed_count ?? 0) + '</td>' +
            '<td class="right mono">' + (r.attendance_pct === null || r.attendance_pct === undefined ? '—' : r.attendance_pct + '%') + '</td>' +
            '<td><span class="risk-chip ' + r.risk_status + '">' + r.risk_status + '</span></td>';
          tr.addEventListener('click', () => openStudentDetail(r.enrolment_id));
          tbody.appendChild(tr);
        }
        renderPagination();
      }

      async function openStudentDetail(enrolmentId) {
        $('drawer').hidden = false;
        $('drawer-body').textContent = 'Loading…';
        try {
          const res = await fetch('/api/dashboard', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ action: 'student_detail', cohort: cohortNumber, enrolmentId }),
          });
          const data = await res.json();
          if (!res.ok) { $('drawer-body').textContent = data.error || 'Failed to load.'; return; }
          renderStudentDetail(data);
        } catch { $('drawer-body').textContent = 'Network error.'; }
      }

      function renderStudentDetail(d) {
        const s = d.summary || {};
        const weeks = d.weeks || [];
        const app = d.application || null;
        $('drawer-title').textContent = (s.first_name || '') + ' ' + (s.last_name || '');

        const body = $('drawer-body');
        body.innerHTML = '';

        const dl = document.createElement('dl');
        function add(label, val) {
          if (val === null || val === undefined || val === '') return;
          const dt = document.createElement('dt'); dt.textContent = label;
          const dd = document.createElement('dd'); dd.textContent = String(val);
          dl.append(dt, dd);
        }
        add('Email',   s.email);
        add('Country', s.country);
        add('City',    s.city);
        add('GitHub',  s.github_url);
        add('Joined week', s.joined_week);
        if (s.left_week) add('Left week', s.left_week);
        add('Accepted', s.accepted_at ? new Date(s.accepted_at).toLocaleDateString() : null);
        add('Accepted by', s.accepted_by);
        body.appendChild(dl);

        // Attendance summary block
        const att = document.createElement('div');
        att.style.cssText = 'margin-top:18px;padding:14px;background:var(--bg-soft, #f5f5f5);border-radius:8px;';
        const pct = s.attendance_pct === null || s.attendance_pct === undefined ? '—' : s.attendance_pct + '%';
        att.innerHTML =
          '<div style="font-size:11px;text-transform:uppercase;letter-spacing:0.05em;color:#888;margin-bottom:6px;">Attendance</div>' +
          '<div style="display:flex;gap:24px;font-family:var(--font-mono);font-size:14px;">' +
            '<span><strong style="font-size:18px">' + pct + '</strong> overall</span>' +
            '<span><strong>' + (s.attended_count || 0) + '</strong> attended</span>' +
            '<span><strong>' + (s.missed_count || 0) + '</strong> missed</span>' +
            '<span class="risk-chip ' + (s.risk_status || 'ok') + '">' + (s.risk_status || 'ok') + '</span>' +
          '</div>';
        body.appendChild(att);

        // Week-by-week
        const weekTitle = document.createElement('h3');
        weekTitle.style.cssText = 'font-size:13px;text-transform:uppercase;letter-spacing:0.05em;color:#666;margin:20px 0 8px;';
        weekTitle.textContent = 'Week-by-week';
        body.appendChild(weekTitle);

        const ul = document.createElement('ul');
        ul.style.cssText = 'list-style:none;margin:0;padding:0;';
        for (const w of weeks) {
          const li = document.createElement('li');
          li.style.cssText = 'padding:8px 12px;border-bottom:1px solid rgba(0,0,0,0.06);display:flex;align-items:center;gap:10px;font-size:13px;';
          let chip;
          if (w.is_break) chip = '<span class="wk-status break">Break</span>';
          else if (w.status) chip = '<span class="wk-status ' + w.status + '">' + w.status + '</span>';
          else if (w.session_date && new Date(w.session_date) < new Date()) chip = '<span class="wk-status pending">No submission</span>';
          else chip = '<span class="wk-status upcoming">Upcoming</span>';

          li.innerHTML =
            '<span class="mono" style="font-size:11px;color:#888;width:30px">W' + w.week_number + '</span>' +
            '<span style="flex:1">' + escapeHtml(w.topic || '') + '</span>' +
            chip;
          ul.appendChild(li);
        }
        body.appendChild(ul);

        // Application snippet
        if (app) {
          const appTitle = document.createElement('h3');
          appTitle.style.cssText = 'font-size:13px;text-transform:uppercase;letter-spacing:0.05em;color:#666;margin:20px 0 8px;';
          appTitle.textContent = 'From their application';
          body.appendChild(appTitle);
          const adl = document.createElement('dl');
          function addApp(l, v) {
            if (v === null || v === undefined || v === '') return;
            const dt = document.createElement('dt'); dt.textContent = l;
            const dd = document.createElement('dd'); dd.textContent = String(v);
            adl.append(dt, dd);
          }
          addApp('Prereq score', app.prereq_score ? app.prereq_score + ' / 25' : null);
          addApp('Role', app.applicant_role);
          addApp('Field of work', app.field_of_work);
          addApp('Hours/week', app.hours_per_week);
          addApp('Motivation', app.motivation);
          body.appendChild(adl);
        }
      }

      function renderPagination() {
        const start = (state.page - 1) * state.pageSize + 1;
        const end = Math.min(state.page * state.pageSize, state.total);
        $('page-info').textContent = state.total === 0 ? '—' : `Showing ${start}–${end} of ${state.total}`;
        $('prev-btn').disabled = state.page === 1;
        $('next-btn').disabled = state.page * state.pageSize >= state.total;
      }

      function debounce(fn, ms) {
        let t; return (...args) => { clearTimeout(t); t = setTimeout(() => fn(...args), ms); };
      }
      function escapeHtml(s) {
        return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
      }
    })();
  </script>
</AppShell>
