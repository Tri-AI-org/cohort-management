---
/**
 * /[number]/facilitator
 *
 * Facilitator's working surface for a cohort:
 *   - List of sessions they lead
 *   - Inline form to submit/update materials per session
 *   - Drawer to view anonymised feedback per session
 *
 * Auth: AppShell gates on kind === 'facilitator'. Organisers can also
 * reach this page by visiting it directly — the API allows kind ===
 * 'organiser' too, and surfaces "as organiser" so the UI shows all
 * sessions (not just one facilitator's).
 */
import AppShell from '../../layouts/AppShell.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const cohorts = await getCollection('cohorts');
  return cohorts
    .filter(c => c.data.portal?.enabled)
    .map(c => ({
      params: { number: String(c.data.number) },
      props:  { cohort: c },
    }));
}

const { cohort } = Astro.props;
const cohortNumber = cohort.data.number;
---
<AppShell
  title={`Facilitator · Cohort ${cohortNumber}`}
  requiredKind="any"
  cohortNumber={cohortNumber}
>
  <div class="container app-page">
    <div style="display:flex; align-items:baseline; justify-content:space-between; gap:var(--space-3); margin-bottom:var(--space-3); flex-wrap:wrap;">
      <div>
        <h1>Facilitator dashboard</h1>
        <p class="lede" id="lede">Loading your sessions…</p>
      </div>
    </div>

    <div id="error" class="auth-msg err" hidden></div>

    <div id="sessions-area" hidden>
      <ul class="fac-list" id="fac-list"></ul>
    </div>

    <div id="empty" class="empty-state" hidden>
      <p>No sessions assigned to you in this cohort yet.</p>
    </div>
  </div>

  <!-- Materials editor drawer -->
  <div class="drawer" id="materials-drawer" hidden>
    <div class="drawer-backdrop" data-drawer-close></div>
    <div class="drawer-panel">
      <header class="drawer-head">
        <h2 id="md-title">Materials</h2>
        <button class="btn-link" data-drawer-close>Close</button>
      </header>
      <div class="drawer-body">
        <form id="md-form">
          <div class="field">
            <label for="md-slides">Slides URL</label>
            <input type="url" id="md-slides" placeholder="https://docs.google.com/presentation/d/…" />
          </div>
          <div class="field">
            <label for="md-notebook">Notebook URL</label>
            <input type="url" id="md-notebook" placeholder="https://colab.research.google.com/…" />
          </div>
          <div class="field">
            <label for="md-recording">Recording URL</label>
            <input type="url" id="md-recording" placeholder="https://youtu.be/…" />
          </div>
          <div class="field">
            <label for="md-readings">Suggested readings (URL or notes)</label>
            <input type="text" id="md-readings" />
          </div>
          <div class="field">
            <label for="md-notes">Notes for organisers (optional)</label>
            <textarea id="md-notes" rows="3"
              placeholder="Anything they should know about this session"></textarea>
          </div>
        </form>
      </div>
      <footer class="drawer-foot">
        <button class="btn primary" id="md-save">Save materials</button>
        <span class="md-status" id="md-status"></span>
      </footer>
    </div>
  </div>

  <!-- Feedback viewer drawer -->
  <div class="drawer" id="feedback-drawer" hidden>
    <div class="drawer-backdrop" data-drawer-close></div>
    <div class="drawer-panel">
      <header class="drawer-head">
        <h2 id="fb-title">Feedback</h2>
        <button class="btn-link" data-drawer-close>Close</button>
      </header>
      <div class="drawer-body" id="fb-body">Loading…</div>
    </div>
  </div>

  <style>
    .fac-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
    .fac-item {
      background: #fff; border: 1px solid var(--border, rgba(0,0,0,0.08));
      border-radius: 10px; padding: 18px 20px;
      display: grid;
      grid-template-columns: 60px 1fr auto;
      gap: 16px; align-items: center;
    }
    .fac-week {
      font-family: var(--font-mono);
      font-size: 26px; font-weight: 700;
      color: var(--gold-deep);
      background: var(--gold-light);
      border-radius: 8px;
      width: 60px; height: 60px;
      display: flex; align-items: center; justify-content: center;
    }
    .fac-body { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    .fac-topic { font-weight: 600; font-size: 15px; }
    .fac-meta  { font-size: var(--t-small); color: var(--text-dim, #888); }
    .fac-organiser-tag {
      display: inline-block; margin-left: 8px;
      font-size: 10px; text-transform: uppercase; letter-spacing: 0.05em;
      padding: 1px 5px; background: rgba(0,0,0,0.06); color: var(--text-dim, #666);
      border-radius: 3px;
    }
    .fac-actions { display: flex; gap: 8px; flex-wrap: wrap; }
    .fac-actions .btn {
      padding: 6px 10px; font-size: var(--t-small);
      background: #fff; border: 1px solid var(--border, #d4d4d4);
      border-radius: 6px; cursor: pointer;
    }
    .fac-actions .btn:hover { background: var(--bg-soft, #fafafa); }

    .materials-status {
      display: inline-block; padding: 2px 7px; border-radius: 4px;
      font-size: 10px; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.05em;
    }
    .ms-pending           { background: rgba(0,0,0,0.05); color: var(--text-dim, #777); }
    .ms-submitted         { background: var(--gold-light); color: var(--gold-deep); }
    .ms-approved          { background: #E8F5EC; color: #1F6B3F; }
    .ms-changes_requested { background: #FBE9E9; color: #8C2020; }

    .drawer { position: fixed; inset: 0; z-index: 100; }
    .drawer-backdrop {
      position: absolute; inset: 0; background: rgba(0,0,0,0.4);
      animation: fade-in 0.15s;
    }
    .drawer-panel {
      position: absolute; top: 0; right: 0; bottom: 0;
      width: min(560px, 100vw);
      background: #fff;
      box-shadow: -4px 0 24px rgba(0,0,0,0.15);
      display: flex; flex-direction: column;
      animation: slide-in 0.2s;
    }
    .drawer-head, .drawer-foot {
      padding: 16px 24px;
      border-bottom: 1px solid var(--border, rgba(0,0,0,0.08));
      display: flex; align-items: center; justify-content: space-between;
      gap: 12px;
    }
    .drawer-foot {
      border-top: 1px solid var(--border, rgba(0,0,0,0.08));
      border-bottom: 0;
    }
    .drawer-body { flex: 1; overflow-y: auto; padding: 20px 24px; }
    .drawer-body input, .drawer-body textarea {
      width: 100%; box-sizing: border-box;
      padding: 9px 12px; border: 1px solid var(--border, #d4d4d4);
      border-radius: 8px; font: inherit; font-size: 14px; background: #fff;
    }
    .drawer-body textarea { resize: vertical; font-family: inherit; }
    .field { margin-bottom: 14px; }
    .field label {
      display: block; font-size: var(--t-small);
      font-weight: 600; margin-bottom: 5px;
    }
    .md-status { color: var(--success); font-size: var(--t-small); }
    .md-status.err { color: var(--alert); }

    .fb-stat-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px;
      margin-bottom: 18px;
    }
    .fb-stat {
      background: var(--bg-soft, #fafafa); border-radius: 8px;
      padding: 12px; text-align: center;
    }
    .fb-stat-label {
      font-size: 10px; text-transform: uppercase; letter-spacing: 0.05em;
      color: var(--text-dim, #888);
    }
    .fb-stat-value {
      font-family: var(--font-mono); font-size: 22px; font-weight: 700;
    }
    .fb-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
    .fb-item {
      background: #fff; border: 1px solid var(--border, rgba(0,0,0,0.06));
      border-radius: 8px; padding: 12px 14px;
      font-size: 14px;
    }
    .fb-item .fb-rating {
      display: inline-block; padding: 2px 7px; border-radius: 4px;
      font-family: var(--font-mono); font-weight: 700; font-size: 12px;
      background: var(--gold-light); color: var(--gold-deep);
      margin-right: 8px;
    }
    .fb-item .fb-text {
      font-size: 13px; line-height: 1.55; margin-top: 4px; color: var(--text, #141414);
    }
    .fb-item .fb-text strong { color: var(--text-dim, #666); }
    @keyframes slide-in { from { transform: translateX(100%); } to { transform: none; } }
    @keyframes fade-in  { from { opacity: 0; } to { opacity: 1; } }

    .empty-state {
      background: #fff;
      border: 1px dashed var(--border, rgba(0,0,0,0.12));
      border-radius: 10px; padding: 32px; text-align: center;
      color: var(--text-dim, #888);
    }
  </style>

  <script is:inline define:vars={{ cohortNumber }}>
    (function () {
      const $ = (id) => document.getElementById(id);
      const state = { sessions: [], asOrganiser: false, currentSessionId: null };

      load();

      async function load() {
        try {
          const res = await fetch('/api/facilitator', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ action: 'overview', cohort: cohortNumber }),
          });
          if (res.status === 401) { location.replace('/signin?cohort=' + cohortNumber); return; }
          if (res.status === 403) {
            $('error').textContent = 'You are not a facilitator on this cohort.';
            $('error').hidden = false;
            $('lede').textContent = '';
            return;
          }
          const data = await res.json();
          if (!res.ok) {
            $('error').textContent = data.error || 'Could not load sessions.';
            $('error').hidden = false;
            return;
          }
          state.sessions = data.sessions || [];
          state.asOrganiser = data.asOrganiser;
          render();
        } catch (err) {
          $('error').textContent = 'Network error loading sessions.';
          $('error').hidden = false;
        }
      }

      function render() {
        const sessions = state.sessions.filter(s => !s.is_break);
        if (sessions.length === 0) {
          $('lede').textContent = state.asOrganiser ? 'No sessions in this cohort yet.' : 'No sessions assigned to you.';
          $('empty').hidden = false;
          return;
        }
        $('lede').textContent = state.asOrganiser
          ? `Showing all ${sessions.length} session(s) in this cohort (organiser view).`
          : `You're leading ${sessions.length} session(s) in this cohort.`;
        const ul = $('fac-list');
        ul.innerHTML = '';
        for (const s of sessions) {
          const li = document.createElement('li');
          li.className = 'fac-item';
          const dt = s.session_date ? formatDate(s.session_date) : '';
          const facBadge = state.asOrganiser && s.fac_email
            ? `<span class="fac-organiser-tag">${escapeHtml(s.fac_first || '')} ${escapeHtml(s.fac_last || '')}</span>`
            : state.asOrganiser ? '<span class="fac-organiser-tag">unassigned</span>' : '';

          li.innerHTML =
            `<div class="fac-week">W${s.week_number}</div>` +
            `<div class="fac-body">` +
              `<div class="fac-topic">${escapeHtml(s.topic || 'Session')} ${facBadge}</div>` +
              `<div class="fac-meta">` +
                `${dt} · <span class="materials-status ms-${s.materials_status}">${formatStatus(s.materials_status)}</span>` +
              `</div>` +
            `</div>` +
            `<div class="fac-actions">` +
              `<button class="btn" data-edit="${s.id}">Edit materials</button>` +
              `<button class="btn" data-feedback="${s.id}">View feedback</button>` +
            `</div>`;
          ul.appendChild(li);
        }
        ul.querySelectorAll('[data-edit]').forEach(b => {
          b.addEventListener('click', () => openMaterials(b.dataset.edit));
        });
        ul.querySelectorAll('[data-feedback]').forEach(b => {
          b.addEventListener('click', () => openFeedback(b.dataset.feedback));
        });
        $('sessions-area').hidden = false;
      }

      // ── Materials drawer ────────────────────────────────────
      function openMaterials(sessionId) {
        const s = state.sessions.find(x => x.id === sessionId);
        if (!s) return;
        state.currentSessionId = sessionId;
        $('md-title').textContent = `Week ${s.week_number} · ${s.topic}`;
        $('md-slides').value    = s.slides_url    || '';
        $('md-notebook').value  = s.notebook_url  || '';
        $('md-recording').value = s.recording_url || '';
        $('md-readings').value  = s.readings_url  || '';
        $('md-notes').value     = s.materials_notes || '';
        $('md-status').textContent = '';
        $('materials-drawer').hidden = false;
      }

      $('md-save').addEventListener('click', async () => {
        const id = state.currentSessionId;
        if (!id) return;
        const status = $('md-status');
        status.className = 'md-status';
        status.textContent = 'Saving…';
        try {
          const res = await fetch('/api/facilitator', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({
              action: 'update_materials',
              cohort: cohortNumber,
              sessionId: id,
              slides_url:    $('md-slides').value.trim(),
              notebook_url:  $('md-notebook').value.trim(),
              recording_url: $('md-recording').value.trim(),
              readings_url:  $('md-readings').value.trim(),
              materials_notes: $('md-notes').value.trim(),
            }),
          });
          const data = await res.json();
          if (!res.ok) {
            status.className = 'md-status err';
            status.textContent = data.error || 'Save failed.';
            return;
          }
          status.textContent = 'Saved.';
          // Update local state
          const s = state.sessions.find(x => x.id === id);
          if (s) {
            s.slides_url    = $('md-slides').value.trim() || null;
            s.notebook_url  = $('md-notebook').value.trim() || null;
            s.recording_url = $('md-recording').value.trim() || null;
            s.readings_url  = $('md-readings').value.trim() || null;
            s.materials_notes = $('md-notes').value.trim() || null;
            if (data.status) s.materials_status = data.status;
          }
          render();
          setTimeout(() => { $('materials-drawer').hidden = true; }, 600);
        } catch (err) {
          status.className = 'md-status err';
          status.textContent = 'Network error.';
        }
      });

      // ── Feedback drawer ────────────────────────────────────
      async function openFeedback(sessionId) {
        const s = state.sessions.find(x => x.id === sessionId);
        if (!s) return;
        $('fb-title').textContent = `Week ${s.week_number} · ${s.topic}`;
        $('fb-body').textContent = 'Loading…';
        $('feedback-drawer').hidden = false;
        try {
          const res = await fetch('/api/facilitator', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ action: 'feedback', cohort: cohortNumber, sessionId }),
          });
          const data = await res.json();
          if (!res.ok) { $('fb-body').textContent = data.error || 'Could not load feedback.'; return; }
          renderFeedback(data);
        } catch (err) {
          $('fb-body').textContent = 'Network error.';
        }
      }

      function renderFeedback(d) {
        const stats = d.stats || {};
        const rows = d.feedback || [];
        const body = $('fb-body');
        body.innerHTML = '';

        const grid = document.createElement('div');
        grid.className = 'fb-stat-grid';
        grid.innerHTML =
          `<div class="fb-stat"><div class="fb-stat-label">Attended</div><div class="fb-stat-value">${stats.attended || 0}</div></div>` +
          `<div class="fb-stat"><div class="fb-stat-label">Missed</div><div class="fb-stat-value">${stats.missed || 0}</div></div>` +
          `<div class="fb-stat"><div class="fb-stat-label">Avg rating</div><div class="fb-stat-value">${stats.avg_rating ?? '—'}</div></div>`;
        body.appendChild(grid);

        if (rows.length === 0) {
          const empty = document.createElement('p');
          empty.style.cssText = 'color:#888; text-align:center; padding:24px 0;';
          empty.textContent = 'No feedback for this session yet.';
          body.appendChild(empty);
          return;
        }

        const ul = document.createElement('ul');
        ul.className = 'fb-list';
        for (const fb of rows) {
          const li = document.createElement('li');
          li.className = 'fb-item';
          let html = '';
          if (fb.rating) html += `<span class="fb-rating">${fb.rating}/5</span>`;
          if (fb.feedback_positive) {
            html += `<div class="fb-text"><strong>What worked:</strong> ${escapeHtml(fb.feedback_positive)}</div>`;
          }
          if (fb.feedback_question) {
            html += `<div class="fb-text"><strong>Still unclear:</strong> ${escapeHtml(fb.feedback_question)}</div>`;
          }
          li.innerHTML = html;
          ul.appendChild(li);
        }
        body.appendChild(ul);
      }

      document.querySelectorAll('[data-drawer-close]').forEach(el => {
        el.addEventListener('click', () => {
          $('materials-drawer').hidden = true;
          $('feedback-drawer').hidden = true;
        });
      });

      function escapeHtml(s) {
        return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
      }
      function formatDate(s) {
        try { return new Date(s).toLocaleDateString(undefined, { weekday:'short', month:'short', day:'numeric', year:'numeric' }); }
        catch { return s; }
      }
      function formatStatus(s) {
        if (s === 'changes_requested') return 'Changes requested';
        return s ? s.charAt(0).toUpperCase() + s.slice(1) : 'Pending';
      }
    })();
  </script>
</AppShell>
