---
/**
 * /admin/
 *
 * The post-login landing page for organisers. Shows a list of
 * cohorts they can manage. Since organisers see every cohort
 * (no per-cohort permissions in this MVP), this is just the
 * cohorts table rendered as cards.
 *
 * Static-generated at build time — we know which cohorts exist
 * from the content collection. The DB might have newer ones we
 * haven't markdown'd yet; that's OK, they can be added by
 * rebuilding the site.
 */
import AppShell from '../../layouts/AppShell.astro';
import { getCollection } from 'astro:content';

const cohorts = (await getCollection('cohorts')).sort(
  (a, b) => (b.data.number || 0) - (a.data.number || 0)
);
---
<AppShell title="Admin · Pick a cohort" requiredKind="organiser">
  <div class="container app-page">
    <h1>Cohorts</h1>
    <p class="lede">Pick a cohort to view its dashboard, applications, and students.</p>

    <div class="cohort-card-grid">
      {cohorts.map((c) => (
        <a class="cohort-card" href={`/${c.data.number}/admin/`}>
          <div class="cohort-card-num mono">
            <span class="cohort-card-num-label">Cohort</span>
            <span class="cohort-card-num-value">{c.data.number}</span>
          </div>
          <div class="cohort-card-body">
            <div class="cohort-card-title">{c.data.title || `Cohort ${c.data.number}`}</div>
            {c.data.partner && (
              <div class="cohort-card-meta">with {c.data.partner}</div>
            )}
            <div class="cohort-card-status">
              <span class={`status-chip ${c.data.status || ''}`}>{c.data.status || 'unknown'}</span>
            </div>
          </div>
        </a>
      ))}
      <a class="cohort-card cohort-card-new" href="/admin/cohorts/new">
        <div class="cohort-card-num mono cohort-card-new-icon">+</div>
        <div class="cohort-card-body">
          <div class="cohort-card-title">Create a new cohort</div>
          <div class="cohort-card-meta">Set up the next cohort with sensible defaults.</div>
        </div>
      </a>
    </div>
  </div>

  <style>
    .cohort-card-grid {
      display: grid; gap: var(--space-4);
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    }
    .cohort-card {
      display: flex; gap: var(--space-4);
      padding: 20px;
      background: #fff;
      border: 1px solid var(--border, rgba(0,0,0,0.08));
      border-radius: 12px;
      text-decoration: none;
      color: inherit;
      transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
    }
    .cohort-card:hover {
      border-color: var(--teaching);
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(0,0,0,0.06);
    }
    .cohort-card-num {
      display: flex; flex-direction: column;
      justify-content: center; align-items: center;
      width: 70px; flex-shrink: 0;
      background: var(--gold-light); color: var(--gold-deep);
      border-radius: 10px; padding: 8px;
    }
    .cohort-card-num-label {
      font-size: 9px; text-transform: uppercase; letter-spacing: 0.08em;
      font-weight: 600; opacity: 0.7;
    }
    .cohort-card-num-value {
      font-family: var(--font-mono);
      font-size: 32px; font-weight: 700; letter-spacing: -0.02em;
      line-height: 1;
    }
    .cohort-card-body { display: flex; flex-direction: column; gap: 6px; flex: 1; }
    .cohort-card-title { font-weight: 600; font-size: 16px; }
    .cohort-card-meta { font-size: var(--t-small); color: var(--text-dim, #777); }
    .cohort-card-status { margin-top: auto; }
    .cohort-card-new {
      border: 1px dashed var(--border, rgba(0,0,0,0.18));
      background: var(--bg-soft, #fafafa);
    }
    .cohort-card-new:hover { border-style: solid; border-color: var(--teaching); background: var(--teaching-light); }
    .cohort-card-new-icon {
      font-size: 36px; font-weight: 300;
      background: rgba(0,0,0,0.04); color: var(--text-dim, #888);
    }
    .cohort-card-new:hover .cohort-card-new-icon {
      background: var(--teaching); color: #fff;
    }
  </style>
</AppShell>
